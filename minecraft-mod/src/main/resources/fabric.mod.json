    "client": ["dev.shadowclient.ShadowClient"]
  },
  "mixins": ["shadowclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
